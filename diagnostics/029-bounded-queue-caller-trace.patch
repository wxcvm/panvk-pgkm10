From: MoveCertificate contributors
Subject: [PATCH] vulkan: identify callers of early semaphore dependencies

Extend the opt-in trace with up to 24 instruction addresses for semaphore
dependencies among the first 64 queue events. No stack memory or application
content is logged. No synchronization semantics are changed.

--- a/src/vulkan/runtime/vk_queue.c
+++ b/src/vulkan/runtime/vk_queue.c
@@ -28,6 +28,7 @@
 #include "util/log.h"
 #include "util/u_atomic.h"
 #include <inttypes.h>
+#include <unwind.h>
 
 #include "vk_alloc.h"
 #include "vk_command_buffer.h"
@@ -47,6 +48,23 @@
 /* Default-off, bounded correlation with the Kbase sync lifecycle trace. */
 DEBUG_GET_ONCE_BOOL_OPTION(movecert_queue_trace, "MOVECERT_SYNC_TRACE", false)
 
+struct movecert_stack_trace {
+   unsigned event;
+   unsigned depth;
+};
+
+static _Unwind_Reason_Code
+movecert_trace_frame(struct _Unwind_Context *context, void *data)
+{
+   struct movecert_stack_trace *trace = data;
+   uintptr_t pc = _Unwind_GetIP(context);
+   if (!pc || trace->depth >= 24)
+      return _URC_END_OF_STACK;
+   mesa_logw("MoveCertStack: event=%u frame=%u pc=%" PRIxPTR,
+             trace->event, trace->depth++, pc);
+   return _URC_NO_REASON;
+}
+
 static void
 movecert_queue_trace(const char *event, struct vk_queue *queue,
                     struct vk_queue_submit *submit, struct vk_semaphore *sem,
@@ -65,6 +83,11 @@
              submit ? submit->wait_count : 0,
              submit ? submit->signal_count : 0,
              submit ? submit->command_buffer_count : 0);
+   /* Only early semaphore dependencies: no continuous unwinding per frame. */
+   if (sem && n <= 64) {
+      struct movecert_stack_trace trace = { .event = n };
+      _Unwind_Backtrace(movecert_trace_frame, &trace);
+   }
 }
 
 static VkResult
