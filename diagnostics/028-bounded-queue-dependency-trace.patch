From: MoveCertificate contributors
Subject: [PATCH] vulkan: correlate bounded sync diagnostics with queue dependencies

Default-off MOVECERT_SYNC_TRACE logs object identities, payload selection and
submission boundaries. No waits, resets, signals or ordering are changed.
Each process emits at most 2048 queue events.

--- a/src/vulkan/runtime/vk_queue.c
+++ b/src/vulkan/runtime/vk_queue.c
@@ -25,6 +25,8 @@
 
 #include "util/perf/cpu_trace.h"
 #include "util/u_debug.h"
+#include "util/log.h"
+#include "util/u_atomic.h"
 #include <inttypes.h>
 
 #include "vk_alloc.h"
@@ -41,6 +43,29 @@
 #include "vk_sync_dummy.h"
 #include "vk_sync_timeline.h"
 #include "vk_util.h"
+
+/* Default-off, bounded correlation with the Kbase sync lifecycle trace. */
+DEBUG_GET_ONCE_BOOL_OPTION(movecert_queue_trace, "MOVECERT_SYNC_TRACE", false)
+
+static void
+movecert_queue_trace(const char *event, struct vk_queue *queue,
+                    struct vk_queue_submit *submit, struct vk_semaphore *sem,
+                    struct vk_sync *sync, uint64_t value)
+{
+   static unsigned count;
+   if (!debug_get_option_movecert_queue_trace())
+      return;
+   unsigned n = p_atomic_inc_return(&count);
+   if (n > 2048)
+      return;
+   mesa_logw("MoveCertQueue: n=%u event=%s queue=%p mode=%u submit=%p "
+             "sem=%p sync=%p value=%llu waits=%u signals=%u commands=%u",
+             n, event, (void *)queue, queue->submit.mode, (void *)submit,
+             (void *)sem, (void *)sync, (unsigned long long)value,
+             submit ? submit->wait_count : 0,
+             submit ? submit->signal_count : 0,
+             submit ? submit->command_buffer_count : 0);
+}
 
 static VkResult
 vk_queue_start_submit_thread(struct vk_queue *queue);
@@ -292,6 +317,9 @@
       .wait_value = wait_value,
    };
 
+   movecert_queue_trace(submit->_wait_temps[submit->wait_count] ?
+                        "wait-temp" : "wait-permanent", queue, submit,
+                        semaphore, sync, wait_value);
    submit->wait_count++;
 }
 
@@ -319,6 +347,7 @@
       .signal_value = signal_value,
    };
 
+   movecert_queue_trace("signal", queue, submit, semaphore, sync, signal_value);
    submit->signal_count++;
 
    return VK_SUCCESS;
@@ -584,6 +613,8 @@
                       struct vk_queue_submit *submit)
 {
    VkResult result;
+
+   movecert_queue_trace("final", queue, submit, NULL, NULL, 0);
 
    /* Now that we know all our time points exist, fetch the time point syncs
     * from any vk_sync_timelines.  While we're here, also compact down the
@@ -654,6 +685,8 @@
 
    if (unlikely(result != VK_SUCCESS))
       return result;
+
+   movecert_queue_trace("driver-done", queue, submit, NULL, NULL, 0);
 
    if (submit->_signal_points) {
       for (uint32_t i = 0; i < submit->signal_count; i++) {
@@ -1056,6 +1089,8 @@
    struct vk_device *device = queue->base.device;
    VkResult result;
 
+   movecert_queue_trace("submit", queue, submit, NULL, NULL, 0);
+
    /* If this device supports threaded submit, we can't rely on the client
     * ordering requirements to ensure submits happen in the right order.  Even
     * if this queue doesn't have a submit thread, another queue (possibly in a
