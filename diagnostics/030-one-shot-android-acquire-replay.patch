+#endif
 
    enum vk_sync_flags sync_flags = 0;
    if (semaphore_type == VK_SEMAPHORE_TYPE_TIMELINE)
@@ -218,10 +221,59 @@
    return VK_SUCCESS;
 }
 
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+void
+vk_semaphore_reset_acquire_replay(struct vk_device *device,
+                                 struct vk_semaphore *semaphore)
+{
+   if (semaphore->android_acquire_replay)
+      vk_sync_destroy(device, semaphore->android_acquire_replay);
+   semaphore->android_acquire_replay = NULL;
+   semaphore->android_acquire_replay_queue = NULL;
+}
+
+VkResult
+vk_semaphore_prepare_acquire_replay(struct vk_device *device,
+                                   struct vk_semaphore *semaphore)
+{
+   vk_semaphore_reset_acquire_replay(device, semaphore);
+   if (semaphore->type != VK_SEMAPHORE_TYPE_BINARY ||
+       semaphore->android_permanent_used || !semaphore->temporary ||
+       device->submit_mode != VK_QUEUE_SUBMIT_MODE_DEFERRED)
+      return VK_SUCCESS;
+
+   const struct vk_sync_type *type = semaphore->temporary->type;
+   if (!type->export_sync_file || !type->import_sync_file)
+      return VK_SUCCESS;
+
+   struct vk_sync *replay = NULL;
+   VkResult result = vk_sync_create(device, type, 0, 0, &replay);
+   if (result != VK_SUCCESS)
+      return result;
+
+   int fd = -1;
+   result = vk_sync_export_sync_file(device, semaphore->temporary, &fd);
+   if (result == VK_SUCCESS) {
+      result = vk_sync_import_sync_file(device, replay, fd);
+      if (fd >= 0)
+         close(fd);
+   }
+   if (result != VK_SUCCESS) {
+      vk_sync_destroy(device, replay);
+      return result;
+   }
+   semaphore->android_acquire_replay = replay;
+   return VK_SUCCESS;
+}
+#endif
+
 void
 vk_semaphore_reset_temporary(struct vk_device *device,
                              struct vk_semaphore *semaphore)
 {
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+   vk_semaphore_reset_acquire_replay(device, semaphore);
+#endif
    if (semaphore->temporary == NULL)
       return;
 
@@ -609,6 +661,12 @@
