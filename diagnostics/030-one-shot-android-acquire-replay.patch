From: MoveCertificate contributors
Subject: [PATCH] vulkan: opt-in one-shot same-queue Android acquire replay

A captured application waits its acquire semaphore twice without a new signal.
Retain a separate copy of the real external acquire fence for one additional
same-queue wait, only after AcquireImageANDROID and only for binary semaphores
whose permanent payload has never been signaled, imported or shared. Signals,
imports and destruction invalidate the copy. Ordinary imports are unchanged.
The permanent payload is never overwritten and no unsignaled fence is faked.

Default-off MOVECERT_ACQ_REPLAY is diagnostic compatibility, not a fix to
valid Vulkan semantics. No global installation or default activation.

--- a/src/vulkan/runtime/vk_semaphore.h
+++ b/src/vulkan/runtime/vk_semaphore.h
@@ -31,6 +31,7 @@
 #endif
 
 struct vk_sync;
+struct vk_queue;
 
 struct vk_semaphore {
    struct vk_object_base base;
@@ -49,6 +50,15 @@
     */
    struct vk_sync *temporary;
 
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+   /* Opt-in compatibility for one repeated acquire wait on the same queue.
+    * This owns a separate copy of the real acquire fence, never permanent.
+    */
+   struct vk_sync *android_acquire_replay;
+   struct vk_queue *android_acquire_replay_queue;
+   bool android_permanent_used;
+#endif
+
    /** Permanent semaphore state.
     *
     * Every semaphore has some form of permanent state.
@@ -64,6 +74,13 @@
 void vk_semaphore_reset_temporary(struct vk_device *device,
                                   struct vk_semaphore *semaphore);
 
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+void vk_semaphore_reset_acquire_replay(struct vk_device *device,
+                                      struct vk_semaphore *semaphore);
+VkResult vk_semaphore_prepare_acquire_replay(struct vk_device *device,
+                                            struct vk_semaphore *semaphore);
+#endif
+
 static inline struct vk_sync *
 vk_semaphore_get_active_sync(struct vk_semaphore *semaphore)
 {
